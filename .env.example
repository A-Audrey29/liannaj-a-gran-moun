# ============================================================
# FEVES — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter le fichier .env dans git
# ============================================================


# ------------------------------------------------------------
# BASE DE DONNÉES (obligatoire)
# ------------------------------------------------------------
# URL de connexion PostgreSQL
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://feves_user:motdepasse@localhost:5432/feves_dev


# ------------------------------------------------------------
# SESSION (obligatoire)
# ------------------------------------------------------------
# Clé secrète pour signer les cookies de session.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 caractères, jamais partagée publiquement.
SESSION_SECRET=changez-moi-avec-une-longue-chaine-aleatoire


# ------------------------------------------------------------
# EMAIL — Brevo (optionnel en développement)
# ------------------------------------------------------------
# Clé API Brevo pour l'envoi d'emails transactionnels.
# En l'absence de cette clé, les emails sont loggués dans la console (dev uniquement).
# Créer un compte sur https://www.brevo.com/ et récupérer la clé dans API & SMTP.
BREVO_API_KEY=xkeysib-votre-cle-api-brevo

# Adresse expéditeur des emails (doit être vérifiée dans Brevo)
BREVO_SENDER_EMAIL=noreply@feves.fr

# Nom affiché comme expéditeur
BREVO_SENDER_NAME=FEVES


# ------------------------------------------------------------
# URL DE BASE (recommandé en production)
# ------------------------------------------------------------
# URL publique de l'application, utilisée pour construire les liens
# dans les emails de validation (ex: lien de confirmation d'inscription).
# En développement, la valeur est déduite automatiquement depuis la requête.
# En production sur Render, mettre l'URL du service : https://feves.onrender.com
BASE_URL=https://feves.onrender.com


# ------------------------------------------------------------
# NOTIFICATIONS PUSH — Web Push VAPID (optionnel)
# ------------------------------------------------------------
# Clés VAPID pour les notifications push (PWA).
# Si absentes, les notifications push sont désactivées silencieusement.
# Générer les clés avec :
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=votre-cle-publique-vapid-base64url
VAPID_PRIVATE_KEY=votre-cle-privee-vapid-base64url

# Contact identifiant l'émetteur push (email ou URL)
VAPID_SUBJECT=mailto:contact@feves.fr
