# ============================================================
# Lyannaj — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter le fichier .env dans git
#
# Toutes ces variables sont validees au demarrage par server/env.ts :
# une valeur manquante ou invalide arrete le serveur avec un message
# explicite, plutot que de degrader silencieusement en production.
# ============================================================


# ------------------------------------------------------------
# BASE DE DONNEES (obligatoire)
# ------------------------------------------------------------
# URL de connexion PostgreSQL
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# ATTENTION : si l'URL contient des caracteres speciaux (& ? #), la mettre
# entre guillemets simples. Sans guillemets, `source .env` coupe la valeur au
# premier & et bascule silencieusement sur une autre base.
DATABASE_URL='postgresql://lyannaj_user:motdepasse@localhost:5432/lyannaj_dev'


# ------------------------------------------------------------
# SESSION (obligatoire)
# ------------------------------------------------------------
# Cle secrete pour signer les cookies de session.
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 caracteres (impose au demarrage), jamais partagee publiquement.
SESSION_SECRET=changez-moi-avec-une-longue-chaine-aleatoire-de-32-caracteres-minimum


# ------------------------------------------------------------
# URL DE BASE (obligatoire en production)
# ------------------------------------------------------------
# URL publique de l'application, utilisee pour construire les liens dans les
# e-mails (validation d'inscription, rappels de feedback).
#
# En developpement, la valeur est deduite de la requete et cette variable est
# optionnelle. En production elle est OBLIGATOIRE : sans elle, les e-mails
# partent avec des liens relatifs inutilisables.
# Sans slash final.
BASE_URL=https://lyannaj.onrender.com


# ------------------------------------------------------------
# PORT (optionnel — defaut 5000)
# ------------------------------------------------------------
# Render fournit cette variable automatiquement.
PORT=5000


# ------------------------------------------------------------
# EMAIL — Brevo (optionnel)
# ------------------------------------------------------------
# Les TROIS variables vont ensemble : soit toutes renseignees, soit aucune.
# Une configuration partielle arrete le demarrage (c'est presque toujours un
# oubli). Sans elles, les e-mails ne sont pas envoyes mais sont loggues.
#
# Creer un compte sur https://www.brevo.com/ et recuperer la cle dans API & SMTP.
BREVO_API_KEY=xkeysib-votre-cle-api-brevo

# Adresse expediteur (doit etre verifiee dans Brevo)
BREVO_SENDER_EMAIL=noreply@lyannaj.fr

# Nom affiche comme expediteur
BREVO_SENDER_NAME=Lyannaj


# ------------------------------------------------------------
# NOTIFICATIONS PUSH — Web Push VAPID (optionnel)
# ------------------------------------------------------------
# Les TROIS variables vont ensemble, meme regle que Brevo ci-dessus.
# Si aucune n'est fournie, les notifications push sont desactivees.
# Generer les cles avec :
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=votre-cle-publique-vapid-base64url
VAPID_PRIVATE_KEY=votre-cle-privee-vapid-base64url

# Contact identifiant l'emetteur push. Doit commencer par mailto: ou https://
VAPID_SUBJECT=mailto:contact@lyannaj.fr


# ------------------------------------------------------------
# SEED DESTRUCTIF (ne jamais definir en production)
# ------------------------------------------------------------
# prisma/seed.ts vide TOUTES les tables avant de recreer des donnees de test.
# Il refuse de tourner si NODE_ENV=production ou si la base n'est pas locale.
# Cette variable desactive ces gardes — a n'utiliser qu'en connaissance de cause.
# ALLOW_DESTRUCTIVE_SEED=yes
