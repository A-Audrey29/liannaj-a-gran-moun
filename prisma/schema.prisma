generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SENIOR
  JUNIOR
  REFERENT_SENIOR
  TEACHER
}

enum InternshipStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum UserStatus {
  PENDING_VALIDATION
  ACTIVE
  SUSPENDED
  BANNED
}

enum RelationStatus {
  PENDING
  PENDING_FIRST_MEETING
  ACTIVE
  PAUSED
  CLOSED
}

enum InterventionStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
  DONE
  COMPLETED_PENDING_FEEDBACK
  COMPLETED
}

enum NotificationType {
  RELATION_REQUEST
  INTERVENTION_PROPOSED
  INTERVENTION_CONFIRMED
  FEEDBACK_REMINDER
  NEW_MESSAGE
  SYSTEM
}

enum CreditMovementType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  role                Role
  status              UserStatus @default(PENDING_VALIDATION)

  birthDate           DateTime?
  phone               String?
  address             String?
  city                String?
  postalCode          String?
  bio                 String?
  desiredActivity     String?
  // Cle logique de la photo, de la forme "/uploads/<uuid>.webp". Les octets
  // vivent dans ProfilePhoto (le disque de l'hebergeur est ephemere), mais on
  // garde ce champ : le client construit ses URL a partir de lui et les
  // donnees existantes le referencent deja.
  profilePhoto        String?
  photo               ProfilePhoto?

  schoolName          String?
  referentTitle       String?
  referentFirstName   String?
  referentLastName    String?
  referentEmail       String?

  trustedPersonName   String?
  trustedPersonEmail  String?

  linkedSeniorId      String?
  linkedSenior        User?      @relation("ReferentSeniorLink", fields: [linkedSeniorId], references: [id], onDelete: SetNull)
  referentAccounts    User[]     @relation("ReferentSeniorLink")

  validatorEmail      String?
  validationToken     String?    @unique
  validationExpiry    DateTime?

  subscriptionActive  Boolean    @default(false)

  categories          UserCategory[]

  sentMessages        Message[] @relation("SentMessages")

  seniorRelations     Relation[] @relation("SeniorRelations")
  juniorRelations     Relation[] @relation("JuniorRelations")

  receivedRecommendations AdminRecommendation[] @relation("ReceivedRecommendations")
  isRecommendedFor        AdminRecommendation[] @relation("IsRecommendedFor")

  payments            PaymentRecord[]

  creditLedgerEntries      CreditLedger[] @relation("SeniorCreditLedger")
  triggeredCreditMovements CreditLedger[] @relation("TriggeredCreditMovements")

  reportsFiled        Report[] @relation("Reporter")
  reportsReceived     Report[] @relation("Target")

  notifications       Notification[]
  pushSubscriptions   PushSubscription[]

  favoriteSeniors     Favorite[] @relation("SeniorFavorites")
  favoriteJuniors     Favorite[] @relation("JuniorFavorites")

  teacherStudents     TeacherStudent[] @relation("TeacherStudents")
  studentTeachers     TeacherStudent[] @relation("StudentTeachers")
  teacherComments     TeacherComment[] @relation("TeacherComments")
  studentComments     TeacherComment[] @relation("StudentComments")
  internships         Internship[]

  availabilities      Availability[] @relation("UserAvailabilities")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([role, status])
  @@index([city])
}

/// Photo de profil stockee en base.
///
/// Le systeme de fichiers de Render est ephemere : tout ce qui est ecrit dans
/// uploads/ disparait a chaque redeploiement. Les octets vivent donc en base,
/// ce qui les fait aussi entrer dans les sauvegardes PostgreSQL — un disque
/// monte n'y serait pas.
///
/// Les images sont redimensionnees et converties en WebP a l'upload
/// (~150 Ko au lieu de 5 Mo), ce qui garde la table legere.
model ProfilePhoto {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nom de fichier logique ("<uuid>.webp"), correspond a User.profilePhoto.
  filename  String   @unique
  data      Bytes
  mimeType  String
  byteSize  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([filename])
}

model Category {
  id        String         @id @default(cuid())
  name      String         @unique
  users     UserCategory[]
  createdAt DateTime       @default(now())
}

model UserCategory {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
}

model Relation {
  id        String         @id @default(cuid())
  seniorId  String
  juniorId  String
  status    RelationStatus @default(PENDING)

  senior    User           @relation("SeniorRelations", fields: [seniorId], references: [id], onDelete: Cascade)
  junior    User           @relation("JuniorRelations", fields: [juniorId], references: [id], onDelete: Cascade)

  interventions Intervention[]
  reports       Report[]
  conversation  Conversation?

  createdAt DateTime @default(now())

  @@unique([seniorId, juniorId])
  @@index([seniorId, status])
  @@index([juniorId, status])
}

model Intervention {
  id              String             @id @default(cuid())
  relationId      String
  relation        Relation           @relation(fields: [relationId], references: [id], onDelete: Cascade)

  scheduledDate   DateTime
  durationMinutes Int                @default(120)
  location        String?
  status          InterventionStatus @default(PROPOSED)
  tasks           String[]           @default([])

  seniorRating    Int?               @db.SmallInt
  seniorComment   String?
  juniorRating    Int?               @db.SmallInt
  juniorComment   String?
  feedbackReminderSentAt DateTime?
  // Rappel J-1 : garantit l'idempotence du cron, qui repasse toutes les 6h sur
  // la meme fenetre de 24h. Sans cette colonne, 4 rappels par rencontre.
  reminderSentAt  DateTime?

  createdAt       DateTime           @default(now())

  creditLedgerEntries CreditLedger[]

  @@index([relationId, status])
  @@index([status, scheduledDate])
}

enum AvailabilityKind {
  AVAILABLE
  UNAVAILABLE
}

model Availability {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserAvailabilities", fields: [userId], references: [id], onDelete: Cascade)

  startAt   DateTime
  endAt     DateTime
  kind      AvailabilityKind @default(AVAILABLE)
  deletedAt DateTime?

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, startAt])
  @@index([startAt])
}

model AdminRecommendation {
  id        String   @id @default(cuid())
  seniorId  String
  juniorId  String
  note      String?

  senior    User     @relation("ReceivedRecommendations", fields: [seniorId], references: [id])
  junior    User     @relation("IsRecommendedFor", fields: [juniorId], references: [id])

  createdAt DateTime @default(now())

  @@unique([seniorId, juniorId])
}

model PaymentRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  label     String
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  // Rempli uniquement pour un achat en ligne (Stripe Checkout). Unique :
  // garantit qu'un webhook rejoue ne credite jamais deux fois le meme achat.
  // Null pour les paiements manuels admin.
  stripeSessionId String? @unique

  creditLedgerEntries CreditLedger[]

  @@index([userId])
}

model CreditLedger {
  id              String             @id @default(cuid())
  seniorId        String
  senior          User               @relation("SeniorCreditLedger", fields: [seniorId], references: [id], onDelete: Cascade)
  type            CreditMovementType
  amount          Int
  reason          String
  triggeredById   String?
  triggeredBy     User?              @relation("TriggeredCreditMovements", fields: [triggeredById], references: [id], onDelete: SetNull)
  interventionId  String?
  intervention    Intervention?      @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  paymentRecordId String?
  paymentRecord   PaymentRecord?     @relation(fields: [paymentRecordId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())

  @@index([seniorId])
  @@index([seniorId, createdAt])
  @@index([interventionId])
}

model Report {
  id         String    @id @default(cuid())
  reporterId String
  targetId   String?
  relationId String?

  reporter   User      @relation("Reporter", fields: [reporterId], references: [id])
  target     User?     @relation("Target", fields: [targetId], references: [id])
  relation   Relation? @relation(fields: [relationId], references: [id])

  reason      String
  message     String    @default("")
  status      String    @default("OPEN")
  handledNote String?
  handledAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([reporterId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  // Tracabilite de l'envoi e-mail. Sans ca, un echec Brevo ne laisse qu'un log
  // serveur (rotatif sur Render) : impossible de repondre a "je n'ai rien recu".
  emailSentAt DateTime?
  emailError  String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  seniorId  String
  juniorId  String
  createdAt DateTime @default(now())

  senior    User     @relation("SeniorFavorites", fields: [seniorId], references: [id], onDelete: Cascade)
  junior    User     @relation("JuniorFavorites", fields: [juniorId], references: [id], onDelete: Cascade)

  @@unique([seniorId, juniorId])
  @@index([seniorId])
}

model Conversation {
  id         String    @id @default(cuid())
  relationId String    @unique
  relation   Relation  @relation(fields: [relationId], references: [id], onDelete: Cascade)
  messages   Message[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  deletedByAdmin Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([conversationId, isRead])
}

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String
  createdAt DateTime @default(now())

  @@index([userId])
}

model TeacherStudent {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  teacher   User     @relation("TeacherStudents", fields: [teacherId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentTeachers", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teacherId, studentId])
  @@index([teacherId])
  @@index([studentId])
}

model TeacherComment {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  content   String
  teacher   User     @relation("TeacherComments", fields: [teacherId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentComments", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([studentId])
}

model Internship {
  id              String           @id @default(cuid())
  studentId       String
  student         User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  companyName     String
  companyAddress  String?
  supervisorName  String?
  supervisorEmail String?
  startDate       DateTime
  endDate         DateTime?
  description     String?
  status          InternshipStatus @default(UPCOMING)
  teacherNotes    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([studentId])
  @@index([status])
}
